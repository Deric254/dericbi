# Optimize JSON loading with compression and caching
/journey-data.json
  Content-Type: application/json
  Cache-Control: public, max-age=300, must-revalidate
  X-Content-Type-Options: nosniff

# Force browser download for Python & SQL source files
/downloads/*.py
  Content-Type: application/octet-stream
  Content-Disposition: attachment
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=3600

/downloads/*.sql
  Content-Type: application/octet-stream
  Content-Disposition: attachment
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=3600

# (Optional) Force download for other raw source if needed
#/downloads/*.ipynb
#  Content-Type: application/octet-stream
#  Content-Disposition: attachment
#  X-Content-Type-Options: nosniff

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=7200
  X-Robots-Tag: index, follow

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=7200
  X-Robots-Tag: index, follow

/manifest.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=86400
  X-Robots-Tag: index, follow

/humans.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

# SEO optimized headers for HTML pages
/*.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1

# Enhanced homepage with proper OG image
/index.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1
  Link: <https://dericbi.vercel.app/assets/img/logo.png>; rel="image_src"

# Ensure logo is always accessible and cacheable
/assets/img/logo.png
  Content-Type: image/png
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  X-Robots-Tag: index, follow

# Security hardening (optional global)
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  X-Robots-Tag: index, follow

# Cache static assets for better performance
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

/assets/font/*
  Cache-Control: public, max-age=31536000, immutable
