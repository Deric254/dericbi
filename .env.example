# Optional AI provider keys for the DAI chatbot (api/chat.js).
#
# Set these as Environment Variables in the Vercel dashboard
# (Project -> Settings -> Environment Variables) — NEVER commit real
# keys to this file or anywhere in the repo.
#
# None of these are required. Configure zero, one, or several — the
# chatbot's built-in knowledge base keeps working either way. If you
# set more than one, api/chat.js tries them in AI_PROVIDER_ORDER until
# one answers.

# NVIDIA NIM — free tier, get a key at https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Order to try providers in (comma-separated). Default shown below.
AI_PROVIDER_ORDER=nvidia,openai,gemini,anthropic
